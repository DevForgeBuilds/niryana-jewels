# Render → your Web Service → Environment tab → add these:

# Same test-mode keys used before (Razorpay Dashboard → Settings → API Keys)
RAZORPAY_KEY_ID="rzp_test_xxxxx"
RAZORPAY_KEY_SECRET="xxxxx"

# Comma-separated list of every frontend origin allowed to call this API.
# Include your Vercel production URL, preview URL, and localhost for dev.
FRONTEND_URLS="http://localhost:3000,https://your-app.vercel.app"

# Render sets PORT automatically — you normally don't need to set this yourself.
# PORT=5000
