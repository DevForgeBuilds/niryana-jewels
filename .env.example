DATABASE_URL="mysql://user:password@host:3306/niryana_jewels"
NEXTAUTH_SECRET="generate-a-random-secret"
RAZORPAY_KEY_ID="rzp_test_xxxxx"
RAZORPAY_KEY_SECRET="xxxxx"
# Same value as RAZORPAY_KEY_ID, exposed to the browser (never put the secret here)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxx"

# URL of the standalone backend (backend/, deployed on Render). Leave empty for
# local dev to use this app's own /api/razorpay/* routes instead.
# In Vercel → Project → Settings → Environment Variables, set this to your
# Render service URL, e.g. https://niryana-backend.onrender.com (no trailing slash)
NEXT_PUBLIC_API_URL=""

# Cloudinary (used by the "Upload" buttons on the Add/Edit Product image & video
# fields). Cloud name is shown on your Cloudinary dashboard; the upload preset
# must have "Signing Mode" set to Unsigned (Settings → Upload → Upload presets).
# Neither value is a secret — they're safe to expose to the browser.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your_unsigned_preset"
NODEMAILER_EMAIL="niryanajewels@gmail.com"
NODEMAILER_PASS="app-password"
